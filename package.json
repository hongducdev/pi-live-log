  "homepage": "https://github.com/hongducdev/pi-live-log#readme",
  "bugs": { "url": "https://github.com/hongducdev/pi-live-log/issues" },
  "keywords": ["pi-package", "pi-extension", "pi", "pi-coding-agent", "live-log", "watchdog", "build", "wsl"],
